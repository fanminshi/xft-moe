#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --job-name=xftmoe
#SBATCH --gpus=4
#SBATCH --cpus-per-task=4
#SBATCH --ntasks-per-node=8
#SBATCH --nodes=1
#SBATCH --time=30:59:59
#SBATCH --output=xft_train_%A.out
#SBATCH --error=xft_train_output_%A.err
set -e
set -x 

module purge
module load 2023
module load Anaconda3/2023.07-2

cd /home/fshi/xft-moe/
source activate xft

